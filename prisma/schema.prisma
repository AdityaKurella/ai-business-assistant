datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Message {
  id        String   @id @default(cuid())
  role      String
  content   String
  createdAt DateTime @default(now())
}
model Customer {
  id        String   @id @default(cuid())
  name      String
  company   String
  email     String
  status    String
  value     String?
  notes     String?
  createdAt DateTime @default(now())
}
model Invoice {
  id        String   @id @default(cuid())
  client    String
  service   String
  amount    String
  status    String   @default("Unpaid")
  createdAt DateTime @default(now())
}