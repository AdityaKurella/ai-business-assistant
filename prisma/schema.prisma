datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Message {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())
}

model Customer {
  id        String   @id @default(cuid())
  userId    String
  name      String
  company   String
  email     String
  status    String
  value     String?
  notes     String?
  createdAt DateTime @default(now())
}

model Invoice {
  id        String   @id @default(cuid())
  userId    String
  client    String
  service   String
  amount    String
  status    String   @default("Unpaid")
  createdAt DateTime @default(now())
}
model Automation {
  id          String   @id @default(cuid())
  userId      String
  title       String
  trigger     String
  action      String
  category    String
  status      String   @default("Draft")
  priority    String   @default("Medium")
  runs        Int      @default(0)
  successRate String   @default("Ready")
  icon        String   @default("⚙️")
  createdAt   DateTime @default(now())
}